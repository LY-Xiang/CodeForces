# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files. Scoped to the pattern's own intent: a bare *.mod would
# also swallow Go's go.mod, which is source rather than a build product.
*.mod
!go.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# bench build state: the hash of what each compiled product was built from.
# The harness regenerates it, so it never belongs in the repository.
bench.lock

# Isolated implementation worktrees
.worktrees/

# backup
backup/

# Python bytecode from bench/tools scripts
__pycache__/
